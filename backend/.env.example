# Local defaults. Production values go in the host dashboard, never in git.
# DATABASE_URL: Neon pooled (hostname contains -pooler). Used by the API.
DATABASE_URL=
# DIRECT_URL: Neon direct (no -pooler). Used by Alembic only.
DIRECT_URL=
# Local: the Vite origin. Production: the Vercel origin, no trailing slash.
# Example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173
# Used in password-reset links logged by the API until email delivery is added.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=60
# Support tickets are emailed here (server-side only — never expose in the frontend).
CONTACT_INBOX_EMAIL=
# SMTP (required for contact tickets). For Gmail use an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_CONTACT_WINDOW_SECONDS=3600
# At least 16 characters. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# false locally (HTTP). true on Render so the refresh cookie is Secure + SameSite=None.
COOKIE_SECURE=false
ANILIST_TIMEOUT_SECONDS=10
ANILIST_SEARCH_CACHE_TTL_SECONDS=300
ANIME_SYNC_TTL_HOURS=24
# Optional in-memory rate limits (per client IP, per minute).
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_EXTENSION_MAX=120
RATE_LIMIT_EXTENSION_WINDOW_SECONDS=60
